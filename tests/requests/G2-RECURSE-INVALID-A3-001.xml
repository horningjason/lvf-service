<?xml version="1.0" encoding="UTF-8"?>
<!--
ATTENTION: A reachable parent LVF (LVF_PARENT_URI) and Forest Guide are required for
this test to pass. The golden file was seeded with both running. If LVF_PARENT_URI is
unset or the parent is unreachable, this test will fail (an unreachable parent produces
a serverError, not the locationValidation recorded in the golden file).

A2=Morton County, A3=Bismarck. Morton County exists in GIS but Bismarck is in Burleigh
County, not Morton County. Both SSAP and RCL fail at ca:A3 — no records in either layer
match A2=Morton County and A3=Bismarck. The civic coverage table has no Morton-County-wide
(wildcard A3) entry, so this is treated as out-of-coverage at A3 and the child recurses to
the parent, which answers with the submitted address invalid at ca:A3 against its own data.
-->
<findService xmlns="urn:ietf:params:xml:ns:lost1" validateLocation="true" recursive="true">
  <location id="L1" profile="civic">
    <civicAddress xmlns="urn:ietf:params:xml:ns:pidf:geopriv10:civicAddr">
      <country>US</country>
      <A1>ND</A1>
      <A2>Morton County</A2>
      <A3>Bismarck</A3>
      <RD>Capitol</RD>
      <STS>Way</STS>
      <HNO>1661</HNO>
    </civicAddress>
  </location>
  <service>urn:service:sos</service>
</findService>
